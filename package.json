{
  "name": "william-portfolio",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url preferredLanguage baseLocale --emit-ts-declarations",
    "build": "vite build",
    "preview": "vite preview",
    "preview:cloudflare": "pnpm build && wrangler pages dev dist",
    "deploy:cloudflare": "pnpm build && pnpm verify:bundle && wrangler pages deploy dist --project-name=william-portfolio",
    "verify:bundle": "test -f dist/_worker.js/index.js && test -f dist/_routes.json && test -f dist/og.png && test -f dist/william-wautrin.jpeg && test -f dist/resume/william-wautrin-cv-fr.pdf && test -f dist/resume/william-wautrin-cv-en.pdf && test -n \"$(find dist/assets -type f -name '*.js' -print -quit)\"",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
